#cloud-config
package_update: true
packages:
  - curl
  - git

write_files:
  - path: /root/install_k3s.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # Install K3s (disable traefik to use custom ingress if needed, but keeping simple for now)
      curl -sfL https://get.k3s.io | sh -s - --write-kubeconfig-mode 644

      # Wait for node to be ready
      sleep 30
      
      export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
      
      # Install ArgoCD
      kubectl create namespace argocd
      kubectl apply -n argocd -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml
      
      # Create application namespace
      kubectl create namespace kraoq

runcmd:
  # Open Firewall Ports for K3s
  - firewall-cmd --permanent --add-port=6443/tcp
  - firewall-cmd --permanent --add-port=80/tcp
  - firewall-cmd --permanent --add-port=443/tcp
  - firewall-cmd --permanent --add-port=30000-32767/tcp # NodePorts
  - firewall-cmd --reload
  
  # Install Cloudflare Tunnel (cloudflared)
  - dnf config-manager --add-repo https://pkg.cloudflare.com/cloudflared-ascii.repo
  - dnf install -y cloudflared
  - cloudflared service install ${cloudflare_tunnel_token}


  # Run installation
  - /root/install_k3s.sh
